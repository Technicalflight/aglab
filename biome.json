{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["src/**", "vite.config.ts", "tsconfig.json", "tsconfig.*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "formatter": { "enabled": true },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": { "enabled": true }
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  }
}
