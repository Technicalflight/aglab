{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the control island overlay",
  "windows": ["main", "control-island"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path",
    "notification:default",
    "updater:default"
  ]
}
