{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aglab",
  "version": "0.1.2",
  "identifier": "com.aglab.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/aglab/**", "$APPDATA/gen/**", "$APPDATA/backups/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://technicalflight.github.io/aglab-site/updater/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMENCOEEyQjBGQ0Q2MTEKUldRUjF2eXdvcmdNOHFwbXU1anhLTy9yV1IvblNibUlLRkRFL20zZ1EybHBJK21XcGdnR0UrbzQK",
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
